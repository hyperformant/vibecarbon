{
  "name": "redis",
  "description": "In-memory store for shared rate limiting, caching and queues",
  "version": "1.0.0",
  "port": 6379,
  "url": "redis://localhost:6379",

  "files": {
    "compose/docker-compose.yml": "docker-compose.redis.yml",
    "compose/docker-compose.prod.yml": "docker-compose.redis.prod.yml",
    "compose/docker-compose.override.yml": "docker-compose.redis.override.yml",
    "k8s/": "k8s/base/redis/",
    "docs/integration.md": "redis-integration.md"
  },

  "envVars": {
    "REDIS_PASSWORD": { "generate": "password", "length": 32 }
  },

  "standby": {
    "policy": "with-app-tier",
    "compose": {
      "services": ["redis"],
      "setup": []
    },
    "k8s": [
      { "kind": "Deployment", "name": "redis", "namespace": "vibecarbon" }
    ]
  },

  "kustomization": {
    "entry": "redis/"
  },

  "credentials": {
    "title": "Redis",
    "fields": [
      { "label": "Host", "value": "localhost:6379" },
      { "label": "Credentials", "value": "Stored in .env.local (REDIS_PASSWORD)" }
    ]
  }
}
