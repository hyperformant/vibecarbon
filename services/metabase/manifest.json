{
  "name": "metabase",
  "description": "Business intelligence and analytics dashboard",
  "version": "1.0.0",
  "port": 3001,
  "url": "http://metabase.localhost",

  "files": {
    "compose/docker-compose.yml": "docker-compose.metabase.yml",
    "compose/docker-compose.prod.yml": "docker-compose.metabase.prod.yml",
    "compose/docker-compose.override.yml": "docker-compose.metabase.override.yml",
    "k8s/": "k8s/base/metabase/",
    "db/init.sh": "volumes/db/metabase-init.sh",
    "scripts/setup.sh": "volumes/metabase/scripts/setup.sh",
    "docs/integration.md": "metabase-integration.md"
  },

  "envVars": {
    "METABASE_ADMIN_PASSWORD": { "from": "ADMIN_PASSWORD" },
    "METABASE_ADMIN_EMAIL": { "from": "ADMIN_EMAIL", "default": "admin@localhost" }
  },

  "kustomization": {
    "entry": "metabase/"
  },

  "credentials": {
    "title": "Metabase",
    "fields": [
      { "label": "URL", "value": "http://metabase.localhost" },
      { "label": "Auth", "value": "Traefik ForwardAuth (super_admin)" }
    ]
  }
}
