#!/bin/bash

# Pre-push hook to catch CI failures before pushing
#
# Runs lint + unit + integration tests (matches CI jobs that must pass).
# E2E and smoke tests are excluded (require Docker, take 15-20 min).
#
# To skip: git push --no-verify
# To run manually: pnpm test:prepush

# CI IS NOT A DEVELOPER MACHINE — and this hook reaches it by accident.
#
# package.json's `prepare` runs `git config core.hooksPath git-hooks`, so
# `pnpm install` in ANY workflow arms these hooks. semantic-release then makes
# a real `git commit` for the version bump, which fires this gate INSIDE the
# release job.
#
# That is exactly how release run 32605420027 died (2026-08-22): the commit
# was rejected by `pnpm lint`, semantic-release aborted during `prepare`, and
# vibecarbon@0.39.16 never published. Note what it was linting — a tree
# semantic-release had just rewritten (bumped package.json, generated
# CHANGELOG.md). The gate was judging output it had never been designed to see.
#
# Re-running the suite here buys nothing: release.yml already REFUSES to
# publish unless test.yml is green for that exact commit. It only adds a second
# place for the release to die.
if [ -n "$CI" ]; then
  echo "CI detected — skipping the local gate (workflow jobs are the gate)."
  exit 0
fi

echo "Running pre-push checks..."
echo ""

pnpm lint || exit 1
pnpm test:unit || exit 1
pnpm test:integration || exit 1

echo ""
echo "All pre-push checks passed."
exit 0
