# Git worktrees
.worktrees/

# Dependencies
# Both forms on purpose: the trailing slash matches directories ONLY, so a
# node_modules SYMLINK (agents create one in git worktrees so the pre-commit
# hooks can resolve biome) shows up as untracked without the bare entry.
node_modules
node_modules/

# Test directories (created by test-stacks.js)
test_carbon/
test-carbon/
my-app/
test-services/

# Reference images and screenshots
.images/

# Build outputs
dist/
*.tsbuildinfo

# Test coverage reports (informational; generated by `vitest --coverage`)
coverage/

# Environment files
.env
.env.local
.env.*.local

# Operator e2e credential tokens (A6) — see tests/.env.e2e.example
tests/.env.e2e

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
*.swp
*.swo

# Claude Code (keep agent definitions, exclude local config)
.claude/settings.local.json
.claude/agent-memory/
.claude/scheduled_tasks.lock
.claude/worktrees/


# Performance test results (machine-local, compare manually)
tests/performance/results/

# CI junit output (test:ci writes it to the repo root)
test-results.xml

# E2E test results (SQLite DB, machine-local)
tests/results/e2e.db
tests/results/e2e.db-shm
tests/results/e2e.db-wal
tests/results/e2e-*.log
# Iteration-specific log tee'd by ad-hoc runs (per-batch, machine-local)
tests/results/iter-*.log
# Active matrix-run PID file written by runner (transient, runtime-only)
tests/results/.current-batch.pid
# Pattern-2 keep-alive rig sentinels — tracked rig coordinates per mode
tests/results/.rig-*.json

# License keys (NEVER commit private keys)
*.key
vibecarbon-license.*
scripts/generate-license-keypair.js

# Font cache for scripts/banner-generator.py — fetched on demand, never vendored
.banner-fonts/

# acme-iso harness: per-trial rendered configs (from *.tpl)
scripts/acme-iso/volumes/traefik/*.yml
